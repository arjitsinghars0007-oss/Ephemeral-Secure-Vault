# Copy this file to .env and fill in your values before running.
# Never commit .env to version control.

# API key required in the X-API-Key header to upload files.
# Use a strong random value in production (e.g. openssl rand -hex 32).
VAULT_API_KEY=secure-vault-2026

# Comma-separated list of allowed CORS origins.
# For local dev this is the Vite dev server. Update for production.
ALLOWED_ORIGINS=http://localhost:5173

